{
	"name": "interview-generator",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev:server": "tsx server.ts",
		"dev:client": "vite",
		"dev": "tsx server.ts & vite",
		"build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
		"start": "node dist/server.mjs",
		"lint": "npx @biomejs/biome check .",
		"lint:fix": "npx @biomejs/biome check . --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"bcrypt": "^6.0.0",
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"esbuild": "^0.28.0",
		"express": "^5.2.1",
		"groq-sdk": "^1.2.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.22.0",
		"swagger-ui-express": "^5.0.1",
		"tsx": "^4.22.2",
		"vite": "^8.0.13",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/bcrypt": "^6.0.0",
		"@types/bcryptjs": "^3.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.8.0",
		"@types/pg": "^8.20.3",
		"@types/swagger-ui-express": "^4.1.8",
		"autoprefixer": "^10.5.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.6"
	}
}
